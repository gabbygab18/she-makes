{% comment %}
  SHEmakes — a row of option cards.

  The same strip the beginner's guide opens with — label, the thing itself, a
  line underneath — but each card can carry a link, so it does the job the
  collections were doing with a centred wall of bullet points: "which listing
  do I use, and why".

  Plain Liquid. A card with no link renders as a card; one with a link renders
  as the same card, clickable.

  Ticking "Side-by-side comparison" swaps the strip for two photo cards: a
  photo, a pill, the title, the surfaces on one line, how it goes on, and a
  button. The whole card is the link — straight to the builder, not to a
  collection in between.
{% endcomment %}

<div class="sm-section sm-section--tight">
  <div class="sm-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="sm-options__head{% if section.settings.compare %} sm-options__head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'sm-heading', text: section.settings.heading, tag: 'h2', class: 'sm-heading sm-heading--md' %}
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="sm-body sm-options__intro">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 and section.settings.compare -%}
      <div class="sm-options sm-options--compare">
        {%- for block in section.blocks -%}
          {%- liquid
            assign pic = ''
            if block.settings.photo != blank
              assign pic = block.settings.photo | image_url: width: 800
            elsif block.settings.photo_asset != blank
              assign pic = block.settings.photo_asset | asset_url
            endif

            assign surfaces = block.settings.surfaces | newline_to_br | split: '<br />'
            assign tag = 'div'
            if block.settings.url != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }} class="sm-options__card{% if block.settings.featured %} sm-options__card--featured{% endif %}"{% if tag == 'a' %} href="{{ block.settings.url }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if pic != blank -%}
              <img class="sm-options__photo" src="{{ pic }}" alt="" width="800" height="600" loading="lazy">
            {%- endif -%}

            {%- if block.settings.label != blank -%}
              <span class="sm-options__badge">{{ block.settings.label }}</span>
            {%- endif -%}

            <span class="sm-options__title">{{ block.settings.title }}</span>

            {%- if block.settings.surfaces != blank -%}
              <span class="sm-options__surfaces">
                {%- for row in surfaces -%}
                  {%- assign surface = row | strip -%}
                  {%- if surface != blank -%}{% unless forloop.first %} • {% endunless %}{{ surface }}{%- endif -%}
                {%- endfor -%}
              </span>
            {%- endif -%}

            {%- if block.settings.badge != blank -%}
              <span class="sm-options__how">
                {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                  <span aria-hidden="true">{% render 'sm-icon', name: block.settings.icon %}</span>
                {%- endif -%}
                {{ block.settings.badge }}
              </span>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <span class="sm-options__cta">{{ block.settings.cta_label }} <span aria-hidden="true">&rarr;</span></span>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="sm-options">
        {%- for block in section.blocks -%}
          {%- if block.settings.url != blank -%}
            <a class="sm-options__card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="sm-options__card" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.label != blank -%}
              <p class="sm-mono sm-options__label">{{ block.settings.label }}</p>
            {%- endif -%}

            <p class="sm-options__title">{{ block.settings.title }}</p>

            {%- if block.settings.note != blank -%}
              <p class="sm-options__note">{{ block.settings.note }}</p>
            {%- endif -%}

            {%- if block.settings.url != blank -%}
              <span class="sm-options__go" aria-hidden="true">&rarr;</span>
            {%- endif -%}

          {%- if block.settings.url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SHEmakes option cards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom orders" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which listing to *use*" },
    { "type": "inline_richtext", "id": "body", "label": "Intro" },
    {
      "type": "checkbox",
      "id": "compare",
      "label": "Side-by-side comparison",
      "info": "Two decision cards with a VS between them. Uses the badge, icon, surfaces and button below.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Easiest" },
        { "type": "text", "id": "title", "label": "Title", "default": "Auto Builder Tool" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "header", "content": "Comparison card" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Side-by-side layout: the line next to the icon, e.g. Heat press needed." },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Pick this one out",
          "info": "Side-by-side layout: a raspberry button and a pink pill instead of ink and honey.",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shirt", "label": "T-shirt" },
            { "value": "tumbler", "label": "Peel and stick" },
            { "value": "printer", "label": "Printer" },
            { "value": "upload", "label": "Upload" },
            { "value": "star", "label": "Star" },
            { "value": "press", "label": "Heat press" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photograph",
          "info": "Replaces the icon."
        },
        {
          "type": "text",
          "id": "photo_asset",
          "label": "Photograph (theme file)",
          "info": "Used when nothing is picked above — the name of a file in the theme's assets, e.g. sm-option-dtf.webp."
        },
        { "type": "textarea", "id": "surfaces", "label": "What it is for", "info": "One per line." },
        { "type": "text", "id": "cta_label", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SHEmakes option cards",
      "blocks": [{ "type": "option" }, { "type": "option" }, { "type": "option" }]
    }
  ]
}
{% endschema %}
