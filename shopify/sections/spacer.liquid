{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: calc({{ section.settings.desktop_padding_top }}px * 0.75);
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
  }
}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="section-{{ section.id }}-padding">
    &nbsp;
  </div>
</div>

{% schema %}
{
  "name": "t:sections.spacer.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
		{
          "value": "accent-3",
          "label": "t:sections.all.colors.accent_3.label"
        },
        {
          "value": "accent-4",
          "label": "t:sections.all.colors.accent_4.label"
        },
		{
          "value": "accent-5",
          "label": "t:sections.all.colors.accent_5.label"
        },
		{
          "value": "accent-6",
          "label": "t:sections.all.colors.accent_6.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.spacer.settings.desktop_padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.spacer.settings.padding.label",
      "default": 40
    },
	{
      "type": "header",
      "content": "t:sections.spacer.settings.mobile_padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.spacer.settings.padding.label",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.spacer.presets.name"
    }
  ]
  }
{% endschema %}