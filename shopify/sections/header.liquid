<{% if section.settings.enable_sticky_header and section.settings.enable_sticky_menu == false %}sticky-header{% else %}div{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header class="header
                 {% if section.settings.logo_position == 'middle-left' %}header--middle-left-center {% else %} header--{{ section.settings.logo_position }}{% endif %}
                 page-width{% if section.settings.menu != blank %} header--has-menu{% endif %}"
          		 {% if section.settings.enable_sticky_menu and section.settings.enable_sticky_header == false %}style="padding-top: 0 !important;"{% endif %}>
    {%- if section.settings.menu != blank -%}
      <header-drawer data-breakpoint="tablet" id="HeaderDrawer">
        <details id="Details-menu-drawer-container" class="test1111 menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <div id="menu-drawer" class="menu-drawer motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu has-submenu list-menu" role="list">
                    {%- comment %}<locksmith:a54e>{% endcomment -%}
                      {%- assign locksmith_a572_forloop__size = 0 %}{%- for link in section.settings.menu.links -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: section.settings.menu, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_a572_forloop__size = locksmith_a572_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_a572_forloop__index = nil -%}
                    {%- comment %}</locksmith:a54e>{% endcomment -%}
                    {%- for link in section.settings.menu.links -%}
                      {%- comment %}<locksmith:9c69>{% endcomment -%}
                        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: section.settings.menu, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_a572_forloop__index == nil %}{% assign locksmith_a572_forloop__index = 1 %}{% assign locksmith_a572_forloop__index0 = 0 %}{% else %}{% assign locksmith_a572_forloop__index = locksmith_a572_forloop__index | plus: 1 %}{% assign locksmith_a572_forloop__index0 = locksmith_a572_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_a572_forloop__index == 1 %}{% assign locksmith_a572_forloop__first = true %}{% else %}{% assign locksmith_a572_forloop__first = false %}{% endif %}{% if locksmith_a572_forloop__index == locksmith_a572_forloop__size %}{% assign locksmith_a572_forloop__last = true %}{% else %}{% assign locksmith_a572_forloop__last = false %}{% endif %}{% assign locksmith_a572_forloop__rindex = locksmith_a572_forloop__size | minus: locksmith_a572_forloop__index | minus: 1 %}{% assign locksmith_a572_forloop__rindex0 = locksmith_a572_forloop__size | minus: locksmith_a572_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                      {%- comment %}</locksmith:9c69>{% endcomment -%}
                      <li>
                        {%- if link.links != blank -%}
                          <details id="Details-menu-drawer-menu-item-{{ locksmith_a572_forloop__index }}">
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                              {{ link.title | escape }}
                              {% render 'icon-arrow' %}
                              {% render 'icon-caret' %}
                            </summary>
                            <div id="link-{{ link.title | escape }}" class="menu-drawer__submenu has-submenu motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  {% render 'icon-arrow' %}
                                  {{ link.title | escape }}
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                  {%- comment %}<locksmith:b2c3>{% endcomment -%}
                                    {%- assign locksmith_6d11_forloop__size = 0 %}{%- for childlink in link.links -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: childlink, subject_parent: link, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_6d11_forloop__size = locksmith_6d11_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_6d11_forloop__index = nil -%}
                                  {%- comment %}</locksmith:b2c3>{% endcomment -%}
                                  {%- for childlink in link.links -%}
                                    {%- comment %}<locksmith:d1f9>{% endcomment -%}
                                      {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: childlink, subject_parent: link, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_6d11_forloop__index == nil %}{% assign locksmith_6d11_forloop__index = 1 %}{% assign locksmith_6d11_forloop__index0 = 0 %}{% else %}{% assign locksmith_6d11_forloop__index = locksmith_6d11_forloop__index | plus: 1 %}{% assign locksmith_6d11_forloop__index0 = locksmith_6d11_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_6d11_forloop__index == 1 %}{% assign locksmith_6d11_forloop__first = true %}{% else %}{% assign locksmith_6d11_forloop__first = false %}{% endif %}{% if locksmith_6d11_forloop__index == locksmith_6d11_forloop__size %}{% assign locksmith_6d11_forloop__last = true %}{% else %}{% assign locksmith_6d11_forloop__last = false %}{% endif %}{% assign locksmith_6d11_forloop__rindex = locksmith_6d11_forloop__size | minus: locksmith_6d11_forloop__index | minus: 1 %}{% assign locksmith_6d11_forloop__rindex0 = locksmith_6d11_forloop__size | minus: locksmith_6d11_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                                    {%- comment %}</locksmith:d1f9>{% endcomment -%}
                                    <li>
                                      {%- if childlink.links == blank -%}
                                        <a href="{{ childlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                          {{ childlink.title | escape }}
                                        </a>
                                      {%- else -%}
                                        <details id="Details-menu-drawer-submenu-{{ locksmith_6d11_forloop__index }}">
                                          <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                            {{ childlink.title | escape }}
                                            {% render 'icon-arrow' %}
                                            {% render 'icon-caret' %}
                                          </summary>
                                          <div id="childlink-{{ childlink.title | escape }}" class="menu-drawer__submenu has-submenu motion-reduce">
                                            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                              {% render 'icon-arrow' %}
                                              {{ childlink.title | escape }}
                                            </button>
                                            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                              {%- for grandchildlink in childlink.links -%}
                                                {%- comment %}<locksmith:ca12>{% endcomment -%}
                                                  {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: grandchildlink, subject_parent: childlink, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                                                {%- comment %}</locksmith:ca12>{% endcomment -%}
