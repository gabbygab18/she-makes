{% comment %}
  SHEmakes — the footer.

  Built rather than restyled. The theme's own footer has a different column
  model, its own logo block and payment icons, so patching it with CSS produced
  a hybrid that matched neither design. This is the footer from the approved
  design, in Liquid.

  Link columns are driven by real Shopify menus (Navigation → Menus), so the
  shop edits them where it edits everything else.
{% endcomment %}

<footer class="sm-footer">
  <div class="sm-container">
    <div class="sm-footer__top">
      {%- comment -%} Brand: mark, tagline, socials. {%- endcomment -%}
      <div class="sm-footer__brand">
        <div class="sm-footer__lockup">
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 260 }}"
            style="max-width: {{ section.settings.logo_width | default: 150 }}px"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            class="sm-footer__logo"
            loading="lazy"
          >
        {%- else -%}
          <span class="sm-footer__wordmark">{{ shop.name }}</span>
        {%- endif -%}

        {%- comment -%}
          The line sits beside the mark rather than under it, the way the
          prototype draws it — see `.sm-footer__lockup` in shemakes.css.
        {%- endcomment -%}
        {%- if section.settings.tagline != blank -%}
          <p class="sm-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        </div>

        {%- comment -%}
          The two facts a shopper looks for at the foot of a page: where to
          write, and when somebody is there to answer. Same chip as the
          contact page and the product card, so they read as one detail
          wherever they appear.
        {%- endcomment -%}
        {%- if section.settings.contact_email != blank or section.settings.contact_hours != blank -%}
          <ul class="sm-contact__facts sm-footer__contact" role="list">
            {%- if section.settings.contact_email != blank -%}
              <li>
                <span class="sm-contact__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v.25l10 7.5 10-7.5V6c0-1.1-.9-2-2-2m1.93 14.51c.04-.16.07-.33.07-.51V8.75l-5.62 4.22 5.55 5.55ZM12.6 15.8c-.18.13-.39.2-.6.2s-.42-.07-.6-.2l-2.16-1.62-5.75 5.75c.16.04.33.07.51.07h16c.18 0 .35-.03.51-.07l-5.75-5.75zM2 8.75V18c0 .18.03.35.07.51l5.55-5.55L2 8.74Z"/>
                  </svg>
                </span>
                <span class="sm-facts__lines"><strong>Email:</strong> <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></span>
              </li>
            {%- endif -%}

            {%- if section.settings.contact_hours != blank -%}
              <li>
                <span class="sm-contact__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.58 2 2 6.58 2 12s4.58 10 10 10 10-4.58 10-10S17.42 2 12 2m5 11h-6V7h2v4h4z"/>
                  </svg>
                </span>
                {%- liquid
                  assign hour_lines = section.settings.contact_hours | strip | newline_to_br | split: '<br />'
                -%}
                <span class="sm-facts__lines">
                  {%- for hour_line in hour_lines -%}
                    {%- assign hour_line = hour_line | strip -%}
                    {%- if hour_line == blank -%}{%- continue -%}{%- endif -%}
                    {%- if forloop.first -%}
                      <strong>{{ hour_line }}</strong>
                    {%- else -%}
                      <span>{{ hour_line }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <ul class="sm-footer__social" role="list">
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.46.66.26 1.22.6 1.77 1.16.56.55.9 1.11 1.16 1.77.24.64.41 1.36.46 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.46 2.43a4.9 4.9 0 0 1-1.16 1.77c-.55.56-1.11.9-1.77 1.16-.64.24-1.36.41-2.43.46-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.46a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.24-.64-.41-1.36-.46-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.46-2.43.26-.66.6-1.22 1.16-1.77.55-.56 1.11-.9 1.77-1.16.64-.24 1.36-.41 2.43-.46C8.94 2.01 9.28 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.25a3.25 3.25 0 1 1 0-6.5 3.25 3.25 0 0 1 0 6.5zM17.25 5.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5z"/></svg>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06V9.7a5.68 5.68 0 1 0 4.91 5.62V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.29 4.29 0 0 1-3.24-1.48z"/></svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Link columns, from real Shopify menus. {%- endcomment -%}
      <div class="sm-footer__columns">
        {%- for block in section.blocks -%}
          {%- assign menu = linklists[block.settings.menu] -%}

          {%- comment -%}
            A column is either a Shopify menu or a list typed here, one
            "Label | /url" per line. The footer wants five specific links out
            of a thirteen-link menu, which no amount of hiding gets to.
          {%- endcomment -%}
          {%- assign custom = block.settings.links | newline_to_br | split: '<br />' -%}

          {%- if custom.size > 0 and block.settings.links != blank -%}
            <div class="sm-footer__column" {{ block.shopify_attributes }}>
              <h2 class="sm-footer__heading">{{ block.settings.heading }}</h2>
              <ul role="list">
                {%- for row in custom -%}
                  {%- assign parts = row | strip | split: '|' -%}
                  {%- if parts.size > 1 -%}
                    <li><a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- elsif menu.links.size > 0 -%}
            <div class="sm-footer__column" {{ block.shopify_attributes }}>
              <h2 class="sm-footer__heading">{{ block.settings.heading | default: menu.title }}</h2>
              {%- comment -%}
                The same hide-and-insert the header does, so a column pointed at
                the header's menu reads the same as the bar above it. Without
                it the footer kept naming links the header no longer has.
              {%- endcomment -%}
              {%- assign hidden_blob = block.settings.hide_titles | downcase | strip | replace: ', ', ',' | prepend: ',' | append: ',' -%}
              {%- assign extra_after = block.settings.extra_after | downcase | strip -%}

              {%- if menu.links.size > 8 -%}
                {%- assign list_class = 'sm-footer__links--split' -%}
              {%- else -%}
                {%- assign list_class = '' -%}
              {%- endif -%}

              <ul role="list" class="{{ list_class }}">
                {%- for link in menu.links -%}
                  {%- assign title_key = link.title | downcase | strip | prepend: ',' | append: ',' -%}
                  {%- unless hidden_blob contains title_key -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endunless -%}

                  {%- assign follows = link.title | downcase | strip -%}
                  {%- if block.settings.extra_label != blank and follows == extra_after -%}
                    <li><a href="{{ block.settings.extra_url | default: routes.collections_url }}">{{ block.settings.extra_label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Newsletter — Shopify's own customer form. {%- endcomment -%}
      {%- if section.settings.show_newsletter -%}
        <div class="sm-footer__newsletter">
          <h2 class="sm-footer__heading">{{ section.settings.newsletter_heading }}</h2>

          {%- if section.settings.newsletter_body != blank -%}
            <p class="sm-footer__tagline">{{ section.settings.newsletter_body }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'sm-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              <p class="sm-footer__success" role="status">
                Thanks — we&rsquo;ll be in touch on Tuesday.
              </p>
            {%- else -%}
              <label class="visually-hidden" for="sm-footer-email">Email address</label>
              <input
                id="sm-footer-email"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Email address"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button type="submit" class="sm-button sm-button--primary">Subscribe</button>
            {%- endif -%}

            {%- if form.errors -%}
              <p class="sm-footer__error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.pickup_hours != blank -%}
            <p class="sm-mono sm-footer__hours">Pickup · {{ section.settings.pickup_hours }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="sm-footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.footer_note != blank %} · {{ section.settings.footer_note }}{% endif -%}
      </p>

      {%- if shop.email != blank -%}
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- comment -%}
  Back to top. The ring around it fills with how far down the page the
  shopper is — a collection here runs to a thousand designs, and "how much
  is left" is worth answering while offering the way back.

  It is a button, not a link to `#`, so it never puts a stray hash in the
  address bar or moves focus to nothing.
{%- endcomment -%}
<button type="button" class="sm-totop sm-tipped" data-sm-tip="Back to top" aria-label="Back to top" hidden>
  <span class="sm-totop__ring" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>
  </svg>
</button>

{% schema %}
{
  "name": "SHEmakes footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "DTF and UV DTF transfers for small businesses, printed in-house and shipped across Canada and the USA."
    },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "info@shemakestransfers.com" },
    { "type": "textarea", "id": "contact_hours", "label": "Hours", "info": "One line. Line breaks are printed as written.", "default": "Business Hours\nMonday \u2013 Friday: 9:00 AM \u2013 5:00 PM EST\nSaturday & Sunday: Closed" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Let's stay connected" },
    {
      "type": "textarea",
      "id": "newsletter_body",
      "label": "Body",
      "default": "New drops every Tuesday, plus subscriber-only codes."
    },
    {
      "type": "text",
      "id": "pickup_hours",
      "label": "Pickup hours",
      "default": "Weekdays 9am–5pm, Saturday 10am–2pm"
    },
    { "type": "header", "content": "Bottom line" },
    { "type": "text", "id": "footer_note", "label": "Note", "default": "Owned and operated by SHEmakes Inc." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links typed by hand",
          "info": "One per line, as \"Label | /url\". Used instead of the menu above."
        },
        {
          "type": "text",
          "id": "hide_titles",
          "label": "Hide these titles",
          "info": "Comma separated, matched against the menu item's own title."
        },
        { "type": "text", "id": "extra_label", "label": "Extra link" },
        { "type": "url", "id": "extra_url", "label": "Extra link goes to" },
        {
          "type": "text",
          "id": "extra_after",
          "label": "Extra link goes after",
          "info": "The title of the menu item it should follow."
        }
      ]
    }
  ]
}
{% endschema %}
