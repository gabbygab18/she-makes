{% comment %}
  SHEmakes — the statement and About panel from the updated contact template.

  A line about the shop, then a photo beside a short "about us" panel. Plain
  Liquid: nothing here changes after it renders.
{% endcomment %}

<div class="sm-section sm-section--tight">
  <div class="sm-container">
    {%- if section.settings.statement != blank -%}
      {% render 'sm-heading', text: section.settings.statement, tag: 'h1', class: 'sm-heading sm-heading--lg sm-about__statement' %}
    {%- endif -%}

    {%- if section.settings.lede != blank -%}
      <p class="sm-body sm-about__lede">{{ section.settings.lede }}</p>
    {%- endif -%}

    <div class="sm-about">
      <div class="sm-about__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1100 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1100 }} 1100w"
            sizes="(min-width: 900px) 45vw, 92vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {%- comment -%}
            A print from the shop floor, bundled with the theme. The box used
            to fall back to an empty placeholder, which on a live page is just
            a cream rectangle beside the words — worse than no box at all.
            Replaceable from the theme editor; this is only what it starts as.
          {%- endcomment -%}
          <img src="{{ 'sm-about.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>

      <div class="sm-about__panel">
        {% render 'sm-heading', text: section.settings.heading, tag: 'h2', class: 'sm-heading sm-heading--md' %}

        {%- if section.settings.body != blank -%}
          <div class="sm-prose rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a class="sm-link" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
            {{ section.settings.cta_label }}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SHEmakes about",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "statement",
      "label": "Statement",
      "default": "We print transfers *the way we would want ours printed*."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "DTF and UV DTF for small businesses and makers. Every sheet is printed, checked and packed on our own floor in London, Ontario — no reseller, no overseas run."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Panel heading", "default": "About us" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Panel text",
      "default": "<p>SHEmakes Transfers is a print shop in London, Ontario. Order by 2pm and it presses the same day.</p><p>Questions get a person, usually the one who printed it.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Link", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Link target" }
  ],
  "presets": [{ "name": "SHEmakes about" }]
}
{% endschema %}
