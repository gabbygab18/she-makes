{% comment %}
  SHEmakes — the Instagram row.

  Images and links, edited in the theme editor. A live feed needs an app: only
  an app holds a Meta access token, and a theme cannot fetch one. This is the
  version that works with no app installed and no token to expire, and it is
  what most "Instagram feed" apps degrade into anyway once the token lapses.

  If a real feed is wanted, install one and add its app block below — the
  section takes @app blocks for exactly that.
{% endcomment %}

<div class="sm-section{% if section.settings.tint != blank and section.settings.tint != 'none' %} sm-section--{{ section.settings.tint }}{% endif %} sm-reveal">
  <div class="sm-container">
    <div class="sm-instagram__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {% render 'sm-heading', text: section.settings.heading, tag: 'h2', class: 'sm-heading sm-heading--md' %}

        {%- if section.settings.body != blank -%}
          <p class="sm-body sm-instagram__intro">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.handle != blank -%}
        <a
          href="{{ section.settings.profile_url | default: '#' }}"
          class="sm-button sm-button--secondary"
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.handle }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.live_feed -%}
      {%- comment -%}
        The shop's real feed. Three Instagram sections ship with this theme;
        the live homepage uses Instafeed (nfcube), whose script Shopify loads
        store-wide and which fills `#insta-feed`. So that div is all this needs
        — no script tag here, and it works in a draft theme for the same
        reason it works on the live one.

        Instagrid and ss-instafeed are the other two, both unused.
      {%- endcomment -%}
      <div class="sm-instagram__feed">
        <div id="insta-feed"></div>
      </div>
    {%- else -%}
    <ul class="sm-instagram__grid" role="list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <li class="sm-instagram__app">{% render block %}</li>

          {%- when 'post' -%}
            {%- if block.settings.image != blank -%}
              <li {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: section.settings.profile_url | default: '#' }}"
                  target="_blank"
                  rel="noopener"
                  class="sm-instagram__item"
                >
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                  <span class="sm-instagram__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="3" width="18" height="18" rx="5"/>
                      <circle cx="12" cy="12" r="4"/>
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                    </svg>
                  </span>
                </a>
              </li>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SHEmakes Instagram",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "tint",
      "label": "Band colour",
      "info": "DESIGN.md builds a page's rhythm from oversized colour blocks with white canvas between them. Never two of the same in a row.",
      "options": [
        { "value": "none", "label": "White" },
        { "value": "cream", "label": "Butter cream" },
        { "value": "honey", "label": "Honey" },
        { "value": "blush", "label": "Blush pink" },
        { "value": "sand", "label": "Pink" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "live_feed",
      "label": "Use the live Instagram feed",
      "default": true,
      "info": "Pulls real posts through the Instagrid app. Turn off to pick the images by hand below."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow along" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pressed and posted" },
    { "type": "textarea", "id": "body", "label": "Text" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@shemakestransfers" },
    { "type": "url", "id": "profile_url", "label": "Profile link" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "Link to the post" },
        { "type": "text", "id": "alt", "label": "Description", "info": "For screen readers." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "SHEmakes Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
