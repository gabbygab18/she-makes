{% comment %}
  SHEmakes — the email sign-up strip.

  Replaces the theme's newsletter section, whose email input is painted black
  by an inline style from the Boho Dream palette — inline, so no stylesheet
  here could have corrected it.

  Shopify's own customer form, so the address still lands in the shop's
  customer list and in whatever the Klaviyo embed syncs.
{% endcomment %}

{%- liquid
  comment
    A photograph behind the sign-up, the way the shop asked for it. The image
    is the shop's own: a picker for one chosen in the theme editor, and a
    print from the shop floor bundled with the theme so the treatment works
    the moment it is switched on, with nothing to upload first.
  endcomment
  assign cta_photo = section.settings.image
  assign has_photo = false
  if section.settings.photo
    assign has_photo = true
  endif
-%}

{%- if has_photo -%}
  {%- comment -%}
    No wave on this one. The wave paints the section's own background across
    the full width, and a full-width dark curve above an inset photo card is
    two different edges arguing. The card sits on the white canvas instead.
  {%- endcomment -%}
  <div class="sm-section sm-newsletter-band">
    <div class="sm-newsletter-band__media">
      {%- if cta_photo != blank -%}
        <img
          src="{{ cta_photo | image_url: width: 2000 }}"
          alt=""
          width="{{ cta_photo.width }}"
          height="{{ cta_photo.height }}"
          loading="lazy"
        >
      {%- else -%}
        <img src="{{ 'sm-cta.jpg' | asset_url }}" alt="" loading="lazy">
      {%- endif -%}

      {%- comment -%}
        Two layers: a flat wash to hold contrast anywhere on the photograph,
        and a stronger foot so the field and the button stay legible.
      {%- endcomment -%}
      <span class="sm-newsletter-band__scrim"></span>
      <span class="sm-newsletter-band__scrim sm-newsletter-band__scrim--foot"></span>
    </div>
  <div class="sm-container sm-newsletter sm-newsletter--on-photo">
{%- else -%}
<div class="sm-section sm-section--cream sm-section--curve">
  <div class="sm-container sm-newsletter">
{%- endif -%}
    {%- if section.settings.badge != blank -%}
      <p class="sm-badge sm-badge--signal sm-newsletter__badge">{{ section.settings.badge }}</p>
    {%- endif -%}

    {% render 'sm-heading', text: section.settings.heading, tag: 'h2', class: 'sm-heading sm-heading--lg' %}

    {%- if section.settings.body != blank -%}
      <p class="sm-body">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'sm-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <label class="visually-hidden" for="sm-newsletter-email">Email address</label>
      <input
        id="sm-newsletter-email"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ section.settings.placeholder }}"
        autocomplete="email"
        required
      >

      <button type="submit" class="sm-button sm-button--primary">{{ section.settings.cta }}</button>
    {%- endform -%}

    {%- if form.posted_successfully? -%}
      <p class="sm-footer__success" role="status">{{ section.settings.success }}</p>
    {%- endif -%}

    {%- if section.settings.contact_email != blank or section.settings.contact_hours != blank -%}
      <ul class="sm-newsletter__contact" role="list">
        {%- if section.settings.contact_email != blank -%}
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v.25l10 7.5 10-7.5V6c0-1.1-.9-2-2-2m1.93 14.51c.04-.16.07-.33.07-.51V8.75l-5.62 4.22 5.55 5.55ZM12.6 15.8c-.18.13-.39.2-.6.2s-.42-.07-.6-.2l-2.16-1.62-5.75 5.75c.16.04.33.07.51.07h16c.18 0 .35-.03.51-.07l-5.75-5.75zM2 8.75V18c0 .18.03.35.07.51l5.55-5.55L2 8.74Z"/>
            </svg>
            <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
          </li>
        {%- endif -%}

        {%- if section.settings.contact_hours != blank -%}
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.58 2 2 6.58 2 12s4.58 10 10 10 10-4.58 10-10S17.42 2 12 2m5 11h-6V7h2v4h4z"/>
            </svg>
            <span>{{ section.settings.contact_hours | newline_to_br }}</span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.small_print != blank -%}
      <p class="sm-newsletter__note">{{ section.settings.small_print }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SHEmakes newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "contact_email", "label": "Email", "default": "info@shemakestransfers.com" },
    { "type": "textarea", "id": "contact_hours", "label": "Hours", "info": "One line. Line breaks are printed as written.", "default": "Monday \u2013 Friday, 9:00 AM \u2013 5:00 PM EST \u00b7 Saturday & Sunday: CLOSED" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "First to know when new designs drop"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "New drops every Tuesday, plus subscriber-only codes."
    },
    { "type": "text", "id": "badge", "label": "Badge above the heading", "default": "10% off your first order" },
    { "type": "header", "content": "Photo background" },
    {
      "type": "checkbox",
      "id": "photo",
      "label": "Photograph behind the sign-up",
      "info": "Uses the image below. With none chosen, a print from the shop floor that ships with the theme is used.",
      "default": true
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Subscribe & get 10% off" },
    { "type": "text", "id": "success", "label": "Thank you message", "default": "You are on the list." },
    {
      "type": "text",
      "id": "small_print",
      "label": "Small print"
    }
  ],
  "presets": [{ "name": "SHEmakes newsletter" }]
}
{% endschema %}
