{% comment %}
  SHEmakes — the questions asked before a first order.

  Answered on the page where they are being asked, rather than sent to a
  separate FAQ page. Built on <details>/<summary>, so it opens without any
  JavaScript and is keyboard-operable for free.
{% endcomment %}
{%- liquid
  assign items = ''
  for block in section.blocks
    assign q = block.settings.question | json
    assign a = block.settings.answer | json
    assign row = '{"question":' | append: q | append: ',"answer":' | append: a | append: '}'
    if forloop.first
      assign items = row
    else
      assign items = items | append: ',' | append: row
    endif
  endfor
-%}
{%- comment -%}
  The questions can come from the FAQ page instead of being typed again here.

  They were two lists with no connection: five written into this section in
  the theme editor, and the shop's own seven living in the page's content.
  Both were right and they answered different questions, which is the one
  thing a FAQ must not do. Point this at the page and the homepage shows the
  first few of the same answers; the island splits the page's headings the
  way the FAQ page itself does.
{%- endcomment -%}
{%- assign source_html = '' -%}
{%- if section.settings.source_page != blank -%}
  {%- comment -%} The theme's extra questions first, as on the FAQ page itself. {%- endcomment -%}
  {%- assign source_html = settings.sm_faq_extra | append: pages[section.settings.source_page].content -%}
{%- endif -%}

{%- capture props -%}
{
  "eyebrow": {{ section.settings.eyebrow | json }},
  "heading": {{ section.settings.heading | json }},
  "html": {{ source_html | json }},
  "limit": {{ section.settings.limit | default: 5 }},
  "items": [{{ items }}],
  "body": {{ section.settings.body | json }},
  "cta": { "label": {{ section.settings.cta_label | json }}, "url": {{ section.settings.cta_url | default: '#' | json }} },
  "secondary": { "label": {{ section.settings.cta2_label | json }}, "url": {{ section.settings.cta2_url | default: '#' | json }} }
}
{%- endcapture -%}

{%- comment -%}
  The Liquid below is the fallback: it renders the whole section, so the
  page is complete before the bundle arrives and stays complete if it
  never does. React replaces it on mount.
{%- endcomment -%}
{%- capture fallback -%}
<div class="sm-section">
  <div class="sm-container">
    <div class="sm-faq sm-faq--split">
      <div class="sm-faq__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sm-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'sm-heading', text: section.settings.heading, tag: 'h2', class: 'sm-heading' %}
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="sm-body">{{ section.settings.body }}</p>
        {%- endif -%}

      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="sm-faq__list">
          {%- for block in section.blocks -%}
            <details class="sm-faq__item" {{ block.shopify_attributes }}>
              <summary class="sm-faq__question">
                <span>{{ block.settings.question }}</span>
                <span class="sm-faq__marker" aria-hidden="true">
                  <span class="sm-faq__bar"></span>
                  <span class="sm-faq__bar sm-faq__bar--up"></span>
                </span>
              </summary>
              <div class="sm-faq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} After the questions, as in the island. {%- endcomment -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
          <div class="sm-faq__actions">
            {%- if section.settings.cta_label != blank -%}
              <a href="{{ section.settings.cta_url | default: '#' }}" class="sm-button sm-button--primary">{{ section.settings.cta_label }}</a>
            {%- endif -%}

            {%- if section.settings.cta2_label != blank -%}
              <a href="{{ section.settings.cta2_url | default: '#' }}" class="sm-button sm-button--secondary">{{ section.settings.cta2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}


    </div>
  </div>
</div>
{%- endcapture -%}

<div class="sm-reveal">
  {% render 'sm-island', name: 'faq', props: props, fallback: fallback %}
</div>

{% schema %}
{
  "name": "SHEmakes FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions we get before almost every first order"
    },
    {
      "type": "page",
      "id": "source_page",
      "label": "Take the questions from this page",
      "info": "The FAQ page. Its questions are shown here, so the two are never out of step. Leave empty to use the blocks below instead."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "How many to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Only when the questions come from a page."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Can't find your answer, or want something printed that is not listed? Message us — we answer the same working day."
    },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Message us" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Second button", "default": "All questions" },
    { "type": "url", "id": "cta2_url", "label": "Second button link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What file should I send?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>A PNG with a transparent background, at 300 DPI for the size you want printed.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SHEmakes FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What file should I send for a custom transfer?" } },
        { "type": "question", "settings": { "question": "What is the difference between DTF and UV DTF?" } },
        { "type": "question", "settings": { "question": "How fast is turnaround, and can you rush it?" } },
        { "type": "question", "settings": { "question": "Do you offer free local pickup?" } }
      ]
    }
  ]
}
{% endschema %}
