          --sm-block-coral: {{ settings.sm_color_signal }};
          --sm-gold: {{ settings.sm_color_signal }};
        {%- endif -%}

        {%- if settings.sm_color_ink != blank -%}
          --sm-ink: {{ settings.sm_color_ink }};
          --sm-ink-body: {{ settings.sm_color_ink }};
          --sm-line: {{ settings.sm_color_ink | color_modify: 'alpha', 0.16 }};
          --sm-line-soft: {{ settings.sm_color_ink | color_modify: 'alpha', 0.09 }};
          --sm-shadow-card: 0 4px 16px {{ settings.sm_color_ink | color_modify: 'alpha', 0.06 }};
          --sm-shadow-lift: 0 4px 16px {{ settings.sm_color_ink | color_modify: 'alpha', 0.16 }};
          --sm-shadow-panel: 0 4px 40px {{ settings.sm_color_ink | color_modify: 'alpha', 0.12 }};
        {%- endif -%}

        {%- if settings.sm_color_ink_muted != blank -%}
          --sm-ink-muted: {{ settings.sm_color_ink_muted }};
          {%- comment -%}
            Breadcrumbs and placeholders: the same plum, lifted toward the
