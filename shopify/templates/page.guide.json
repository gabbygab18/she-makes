        "s1": {
          "type": "step",
          "settings": {
            "title": "Pre-press the garment",
            "body": "<p>Press the blank on its own for 3–5 seconds, then lift. This dries the fabric and flattens the seams, and it is the single biggest difference between a transfer that lasts and one that lifts at the edge.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Place the transfer face up",
            "body": "<p>The printed side faces you; the clear film sits on top. Position it while the garment is still warm and press it flat with your hand so nothing shifts when the platen comes down.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Press at 300°F for 10 seconds",
            "body": "<p>Medium-firm pressure. If your press runs hot, start at the low end and add time rather than temperature — DTF scorches before it under-cures.</p>"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Peel hot, in one motion",
            "body": "<p>Lift a corner straight away and pull the film off in one steady motion, low and across the design rather than up. These are hot peel: waiting for it to cool is what makes the print come away with the film.</p>"
          }
        },
        "s5": {
          "type": "step",
          "settings": {
            "title": "Re-press for 5 seconds",
            "body": "<p>Cover the design with parchment or a Teflon sheet and press again for 5 seconds. This sets the print into the fibres and takes the shine off. Let it cool before you fold it.</p>"
          }
        },
        "s6": {
          "type": "step",
          "settings": {
            "title": "Wash it inside out, cold",
            "body": "<p>Wait 24 hours before the first wash. Inside out, cold, tumble low or hang. No bleach, and never iron directly on the design.</p>"
          }
        },
        "r1": {
          "type": "rule",
          "settings": {
            "icon": "shield",
            "title": "PNG with a transparent background",
            "body": "Not JPG. A JPG has no transparency, so it prints with a white box around your design."
          }
        },
        "r2": {
          "type": "rule",
          "settings": {
            "icon": "star",
            "title": "300 DPI at the size you want printed",
            "body": "A 300 DPI file at 3 inches is not a 300 DPI file at 11 inches. Set the size first, then check the resolution."
          }
        },
        "r3": {
          "type": "rule",
          "settings": {
            "icon": "time",
            "title": "No pencil-thin lines",
            "body": "Anything finer than about 1mm can lift when the film is peeled. Thicken the line or scale the design up."
          }
        },
        "r4": {
          "type": "rule",
          "settings": {
            "icon": "leaf",
            "title": "Trim the empty space",
            "body": "Your transfer prints the size of the box around your image, so extra canvas is paid-for blank film."
          }
        },
