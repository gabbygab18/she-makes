      },
      {
        "type": "header",
        "content": "Running header"
      },
      {
        "type": "paragraph",
        "content": "The scrolling strip of claims above the menu."
      },
      {
        "type": "color",
        "id": "sm_color_ticker_bg",
        "label": "Strip background",
        "default": "#3a1a24"
      },
      {
        "type": "color",
        "id": "sm_color_ticker_text",
        "label": "Strip text",
        "default": "#ffffff"
