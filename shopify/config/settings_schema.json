        "label": "Honey band",
        "default": "#fdecc0"
      },
      {
        "type": "color",
        "id": "sm_color_band_pink",
        "label": "Pink band",
        "default": "#fbd6e3"
      },
      {
        "type": "color",
        "id": "sm_color_panel",
        "label": "Panel inside a band",
        "default": "#fdf1f5",
