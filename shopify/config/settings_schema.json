  {
    "name": "SHEmakes redesign",
    "settings": [
      {
        "type": "header",
        "content": "Free shipping"
      },
      {
        "type": "collection",
        "id": "sm_upsell_collection",
        "label": "\"Add these too\" products",
        "info": "The collection the cart drawer offers alongside what is already in the bag. Leave empty to let Shopify choose — the shop's complementary list first, then its own recommendations."
      },
      {
        "type": "number",
        "id": "sm_free_shipping_threshold",
        "label": "Free shipping threshold (in cents)",
        "info": "15000 is $150. This one number drives the progress bar in the cart and the drawer — move it and every nudge on the site follows.",
        "default": 15000
      },
      {
        "type": "header",
        "content": "Discount tab"
      },
      {
        "type": "paragraph",
        "content": "The small button in the bottom corner that opens the sign-up pop-up. Leave the form ID empty to hide it and let Klaviyo draw its own teaser instead."
      },
      {
        "type": "text",
        "id": "sm_klaviyo_form_id",
        "label": "Klaviyo form ID",
        "info": "In Klaviyo: Sign-up forms → the form → the ID in the URL, e.g. XyZ123."
      },
      {
        "type": "text",
        "id": "sm_klaviyo_label",
        "label": "Button text",
        "default": "Get 10% Off"
      },
      {
        "type": "select",
        "id": "sm_klaviyo_side",
        "label": "Button side",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "type": "header",
        "content": "FAQ"
      },
      {
        "type": "html",
        "id": "sm_faq_extra",
        "label": "Extra questions",
        "info": "Shown ahead of the FAQs page's own questions, on the FAQ page and the homepage. Each question is an <h3>, its answer the paragraphs or list under it."
      }
    ]
  },
  {
    "name": "SHEmakes colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "Every colour on the redesigned sections comes from here. The stylesheet only ever names these, so changing one repaints every place it is used — buttons, bands, chips, borders and shadows together."
      },
      {
        "type": "header",
        "content": "Core"
      },
      {
        "type": "color",
        "id": "sm_color_brand",
        "label": "Brand",
        "default": "#8c0137",
        "info": "Buttons, prices, links, selected states and the dark band."
      },
      {
        "type": "color",
        "id": "sm_color_signal",
        "label": "Accent",
        "default": "#e74a86",
        "info": "Sale and rush badges, add to cart, review stars."
      },
      {
        "type": "color",
        "id": "sm_color_ink",
        "label": "Text",
        "default": "#3a1a24",
        "info": "Headings and body. Hairlines and shadows are mixed from this, so they stay in key."
      },
      {
        "type": "color",
        "id": "sm_color_ink_muted",
        "label": "Muted text",
        "default": "#6d4450",
        "info": "Captions, meta and placeholders."
      },
      {
        "type": "color",
        "id": "sm_color_shell",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "sm_color_paper",
        "label": "Soft surface",
        "default": "#fff5e5",
        "info": "Chips, icon buttons, hover fills."
      },
      {
        "type": "header",
        "content": "Section bands"
      },
      {
        "type": "paragraph",
        "content": "The oversized colour blocks that carry the rhythm down a page."
      },
      {
        "type": "color",
        "id": "sm_color_band_cream",
        "label": "Cream band",
        "default": "#fff5e5"
      },
      {
